# JarSol Web 4.0 Environment Configuration
GEMINI_API_KEY=
PORT=3001
VITE_PORT=5173
SOLANA_NETWORK=testnet
SOLANA_RPC_URL=https://api.testnet.solana.com

# Local listener by default. Use a TLS gateway before exposing a server.
JARSOL_HOST=127.0.0.1
# Optional server-only random 32-byte hexadecimal operator credential.
# Leave blank to disable privileged actions. Never use a VITE_ variable for it.
JARSOL_OPERATOR_TOKEN=
# Keep any real keypair file outside the repository and static directories.
SOLANA_KEYPAIR_PATH=
